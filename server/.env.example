# Copiar como server/.env y completar. NUNCA subir .env al repositorio.

# Cadena de conexión de Supabase. Usar el "Session pooler" (puerto 5432, compatible IPv4):
# Supabase > Project > Connect > Session pooler
DATABASE_URL=postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# require = TLS obligatorio (Supabase). disable = solo para PostgreSQL local.
DB_SSL=require
# Opcional: ruta al certificado CA de Supabase (Project Settings > Database > SSL) para validar el servidor.
# DB_SSL_CA=./prod-ca-2021.crt

# Secreto para firmar sesiones. Generar uno largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

PORT=4000
# Origen del frontend permitido por CORS
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
